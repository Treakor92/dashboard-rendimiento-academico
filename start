#!/bin/bash
set -e

export DASH_PORT="${DASH_PORT:-8050}"
export DASH_REQUESTS_PATHNAME_PREFIX="${JUPYTERHUB_SERVICE_PREFIX:-/}proxy/${DASH_PORT}/"
python app.py > /tmp/dashboard-rendimiento.log 2>&1 &
dashboard_listo=0
for intento in {1..30}; do
  if curl -fsS "http://127.0.0.1:${DASH_PORT}/" > /dev/null; then
    dashboard_listo=1
    break
  fi
  sleep 1
done

if [ "$dashboard_listo" -ne 1 ]; then
  cat /tmp/dashboard-rendimiento.log >&2
  exit 1
fi

exec "$@"
